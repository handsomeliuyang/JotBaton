// Shared.xcconfig
// Shared configuration for Remarc

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = Remarc
PRODUCT_DISPLAY_NAME = Remarc
INFOPLIST_KEY_CFBundleDisplayName = $(PRODUCT_DISPLAY_NAME)
EXECUTABLE_NAME = Remarc
REMARC_URL_SCHEME = remarc
PRODUCT_BUNDLE_IDENTIFIER = com.metepolat.Remarc
MARKETING_VERSION = 1.2.11
CURRENT_PROJECT_VERSION = 30

// ==========================================
// Platform Configuration
// ==========================================
MACOSX_DEPLOYMENT_TARGET = 14.0

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Remarc/Info.plist
INFOPLIST_KEY_LSUIElement = YES

// ==========================================
// App Icon
// ==========================================
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// ==========================================
// Runpath Search Paths (for embedded frameworks like Sparkle)
// ==========================================
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks

// ==========================================
// Code Signing
// ==========================================
CODE_SIGN_STYLE = Manual
CODE_SIGNING_ALLOWED = NO
CODE_SIGNING_REQUIRED = NO
DEVELOPMENT_TEAM =

// ==========================================
// Entitlements
// ==========================================
CODE_SIGN_ENTITLEMENTS = Config/Remarc.entitlements
